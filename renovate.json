{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "automergeSchedule": ["before 3am on monday"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "automergeType": "pr"
  },
  "prConcurrentLimit": 1,
  "prHourlyLimit": 2
}


